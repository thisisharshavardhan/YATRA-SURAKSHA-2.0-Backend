# Server Configuration
PORT=3000
CORS=*

# MongoDB Connection
MONGO_URI="mongodb://username:password@host:27017/database?authSource=admin"

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=config/your-firebase-adminsdk.json
FIREBASE_API_KEY=

# Azure OpenAI GPT-Realtime (Voice Assistant)
AZURE_OPENAI_REALTIME_ENDPOINT=wss://your-resource.cognitiveservices.azure.com/openai/realtime
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-realtime

# Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia

# Azure Translator
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=centralindia

# POI API (FastAPI + PostGIS for nearby places)
POI_API_URL=http://your-poi-server:8000

# Optional: Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:27b-cloud